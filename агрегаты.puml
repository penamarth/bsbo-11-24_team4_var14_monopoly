@startuml

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam groupInheritance 2
skinparam ranksep 42
skinparam nodesep 32
hide circle
hide empty members

package "Game aggregate · games" as GameAggregate {
  class Game {
    + List<Player> Players
    + Board Board
    + Dice Dice
    + Deck ChanceDeck
    + Deck CommunityChestDeck
    + Auction? Auction
    + GameStatus Status
    + int CurrentPlayerIndex
  }

  class Player {
    + string Name
    + int Cash
    + int Position
    + bool InJail
    + int JailTurns
    + bool Bankrupt
  }

  class Dice {
    + int Value1
    + int Value2
  }

  class Auction {
    + Property Property
    + List<Player> Participants
    + int CurrentBid
    + Player? HighestBidder
  }

  Game --> "0..*" Player : Players
  Game --> Dice
  Game --> "0..1" Auction
}

package "Board aggregate · boards" as BoardAggregate  {
  class Board {
    - readonly Square[] _squares
  }

  abstract class Square {
    + string Name
    + int Position
  }

  abstract class Property {
    + int Price
    + Player? Owner
  }

  class Street {
    + string ColorGroup
    + int HouseCost
    + int[] RentLevels
    + int HouseCount
    + bool HasHotel
  }

  class Railroad
  class Utility

  class Tax {
    + int Amount
  }

  class Chance {
    + Deck Deck
  }

  class CommunityChest {
    + Deck Deck
  }

  class Go
  class Jail
  class FreeParking
  class GoToJail

  Board --> "40" Square
  Square <|-- Property
  Square <|-- Tax
  Square <|-- Chance
  Square <|-- CommunityChest
  Square <|-- Go
  Square <|-- Jail
  Square <|-- FreeParking
  Square <|-- GoToJail
  Property <|-- Street
  Property <|-- Railroad
  Property <|-- Utility
}

package "Deck aggregate · decks" as DeckAggregate  {
  class Deck {
    - readonly List<Card> _cards
    + string Name
  }

  class Card {
    + string Description
    + EffectType EffectType
    + int Amount
    + int TargetPosition
  }

  Deck --> "0..*" Card : _cards {ordered}
}

Game -down-> Board
Game -right-> "2" Deck
Auction -[norank]-> Property : Property
Property -[norank]-> "0..1" Player : Owner
Chance -[norank]-> Deck : Deck
CommunityChest -[norank]-> Deck : Deck

@enduml
