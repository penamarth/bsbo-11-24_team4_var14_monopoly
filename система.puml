@startuml
scale 0.85
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 70

class Program <<static>> {
  + static void Main()
  - static void BuildMenu(Game game, Player player, IInput input)
  - static void ShowProperties(Game game, Player player)
  - static string Describe(Game game, Player player)
  - static void ShowPlayers(Game game)
}

class Game {
  + const int StartCash = 1500
  + const int MinPlayers = 2
  + const int MaxPlayers = 6
  - readonly IInput _input
  - readonly Random? _random
  + List<Player> Players { get; } = new List<Player>()
  + Board Board { get; }
  + Dice Dice { get; }
  + Deck ChanceDeck { get; }
  + Deck CommunityChestDeck { get; }
  + Auction? Auction {get; private set}
  + GameStatus Status {get; private set} = GameStatus.NotStarted
  + int CurrentPlayerIndex {get; private set}
  + Game(IInput input, Dice dice, Random? random = null)
  + void StartGame(List<string> playerNames)
  + Player GetCurrentPlayer()
  + List<Player> GetActivePlayers()
  + void PlayTurn()
  + bool AskBuyDecision(Player player, Property property)
  + void OfferPurchase(Player player, Property property)
  + Player? StartAuction(Property property)
  + void ChargePayment(Player payer, Player? receiver, int amount)
  + void HandleBankruptcy(Player debtor, Player? creditor, int amount)
  - void SellAllBuildings(Player player)
  + bool BuildHouse(Player player, Street street)
  + void AdvanceToNextPlayer()
  + bool CheckGameOver()
  + Player? GetWinner()
  + void Log(string message)
}

enum GameStatus {
  NotStarted
  InProgress
  Finished
}

class Board {
  + const int Size = 40
  - readonly Square[] _squares
  + Board(Square[] squares)
  + Square GetSquare(int position)
  + List<Property> GetPropertiesOf(Player player)
  + List<Street> GetStreetsInGroup(string colorGroup)
  + bool OwnsWholeGroup(Player player, string colorGroup)
  + bool IsBuildingEven(Street street)
  + int CountRailroadsOf(Player player)
  + int CountUtilitiesOf(Player player)
  + void TransferProperties(Player from, Player to)
  + void ReleaseProperties(Player player)
  + static Board CreateStandard(Deck chanceDeck, Deck communityChestDeck)
}

class Player {
  + const int BoardSize = 40
  + const int GoReward = 200
  + const int JailPosition = 10
  + const int JailTurnsToLeave = 3
  + string Name { get; }
  + int Cash {get; private set}
  + int Position {get; private set}
  + bool InJail {get; private set}
  + int JailTurns {get; private set}
  + bool Bankrupt {get; private set}
  + Player(string name, int cash)
  + bool Move(int steps)
  + bool MoveTo(int position)
  + void Pay(int amount)
  + void Receive(int amount)
  + bool CanAfford(int amount)
  + void SendToJail()
  + bool TryLeaveJail()
  + void DeclareBankrupt()
  + override string ToString()
}

class Dice {
  - readonly Random _random
  + int Value1 {get; protected set}
  + int Value2 {get; protected set}
  + Dice() : this(new Random())
  + Dice(Random random)
  + virtual int Roll()
  + int GetSum()
}

class Auction {
  + Property Property { get; }
  + List<Player> Participants { get; }
  + int CurrentBid {get; private set}
  + Player? HighestBidder {get; private set}
  + Auction(Property property, List<Player> participants)
  + bool PlaceBid(Player player, int amount)
  + void Pass(Player player)
  + bool IsFinished()
  + Player? Conclude()
}

interface IInput {
  + bool AskYesNo(string question)
  + int AskNumber(string question)
  + string AskText(string question)
}

class ConsoleInput {
  + bool AskYesNo(string question)
  + int AskNumber(string question)
  + string AskText(string question)
}

class Card {
  + string Description { get; }
  + EffectType EffectType { get; }
  + int Amount { get; }
  + int TargetPosition { get; }
  + Card(string description, EffectType effectType, int amount = 0, int targetPosition = 0)
  + void ApplyEffect(Player player, Game game)
}

class Deck {
  - readonly List<Card> _cards
  + string Name { get; }
  + int Count
  + Deck(string name, List<Card> cards)
  + Card DrawCard()
  + void ReturnToBottom(Card card)
  + void Shuffle(Random random)
  + static Deck CreateChanceDeck()
  + static Deck CreateCommunityChestDeck()
}

enum EffectType {
  Fine
  Bonus
  MoveTo
  GoToJail
}

abstract class Square {
  + string Name { get; }
  + int Position { get; }
  # Square(string name, int position)
  + abstract void OnLand(Player player, Game game)
  + override string ToString()
}

abstract class Property {
  + int Price { get; }
  + Player? Owner {get; private set}
  # Property(string name, int position, int price)
  + bool IsFree()
  + Player? GetOwner()
  + void SetOwner(Player? player)
  + override void OnLand(Player player, Game game)
  + abstract int CalculateRent(Game game)
}

class Street {
  + const int MaxHouses = 4
  + string ColorGroup { get; }
  + int HouseCost { get; }
  + int[] RentLevels { get; }
  + int HouseCount {get; private set}
  + bool HasHotel {get; private set}
  + Street(string name, int position, int price, string colorGroup, int houseCost, int[] rentLevels)
  + int GetBuildingLevel()
  + override int CalculateRent(Game game)
  + bool CanBuild(Player player, Board board)
  + void AddHouse()
  + void RemoveHouse()
  + void ClearBuildings()
}

class Railroad {
  + const int BaseRent = 25
  + Railroad(string name, int position, int price)
  + override int CalculateRent(Game game)
}

class Utility {
  + Utility(string name, int position, int price)
  + override int CalculateRent(Game game)
}

class Tax {
  + int Amount { get; }
  + Tax(string name, int position, int amount)
  + override void OnLand(Player player, Game game)
}

class Chance {
  + Deck Deck { get; }
  + Chance(string name, int position, Deck deck)
  + override void OnLand(Player player, Game game)
}

class CommunityChest {
  + Deck Deck { get; }
  + CommunityChest(string name, int position, Deck deck)
  + override void OnLand(Player player, Game game)
}

class Go {
  + Go(string name, int position)
  + override void OnLand(Player player, Game game)
}

class Jail {
  + Jail(string name, int position)
  + override void OnLand(Player player, Game game)
}

class FreeParking {
  + FreeParking(string name, int position)
  + override void OnLand(Player player, Game game)
}

class GoToJail {
  + GoToJail(string name, int position)
  + override void OnLand(Player player, Game game)
}

Square <|-- Property
Square <|-- Tax
Square <|-- Chance
Square <|-- CommunityChest
Square <|-- Go
Square <|-- Jail
Square <|-- FreeParking
Square <|-- GoToJail
Property <|-- Street
Property <|-- Railroad
Property <|-- Utility
IInput <|.. ConsoleInput
Game -[norank]-> "0..*" Player : Players
Game -down-> Board
Game -down-> Dice
Game -[norank]-> "2" Deck
Game -[norank]-> "0..1" Auction
Game -[norank]-> IInput
Game -down-> GameStatus
Board --> "40" Square : _squares
Property -[norank]-> "0..1" Player : Owner
Chance -[norank]-> Deck
CommunityChest -[norank]-> Deck
Deck --> "0..*" Card
Card --> EffectType
Auction -[norank]-> Property
Auction -[norank]-> "0..*" Player : Participants
Auction -[norank]-> "0..1" Player : HighestBidder
Program .up.> Game
Program .[norank].> ConsoleInput
Game -[hidden]down-> Player
Game -[hidden]down-> Auction
Game -[hidden]down-> Deck
Game -[hidden]down-> IInput
@enduml

