@startuml

actor "Организатор" as Пользователь
participant "Игра" as Игра
participant "Доска" as Доска
participant "Клетка" as Клетка
participant "Игрок" as Игрок
participant "Колода" as Колода
participant "Карточка" as Карточка
participant "Кубики" as Кубики

Пользователь -> Игра : начатьНовуюИгру()
note right: запускает создание партии
activate Игра

Игра -> Игра : создать()
note right: статус = «настройка»

Игра -> Доска : создать()
activate Доска
loop 40 раз
    Доска -> Клетка : создать(позиция, тип)
    note right: у собственностей владелец пусто
end
Игра <-- Доска : доска
deactivate Доска

loop пока организатор добавляет игроков
    Пользователь -> Игра : добавитьИгрока(имя)
    alt имя непустое, уникальное, игроков < 6
        Игра -> Игрок : создать(имя)
        activate Игрок
        note right: cash = стартовый капитал,\nposition = 0, inJail = нет, bankrupt = нет
        Игра <-- Игрок : игрок
        deactivate Игрок
    else имя некорректно или лимит достигнут
        Пользователь <-- Игра : ошибка
    end
end

Пользователь -> Игра : начатьИгру()

alt игроков от 2 до 6
    Игра -> Колода : создать(Шанс)
    activate Колода
    Колода -> Карточка : создать(эффект, сумма, описание)
    Колода -> Колода : перемешать()
    deactivate Колода

    Игра -> Колода : создать(Общая казна)
    activate Колода
    Колода -> Карточка : создать(эффект, сумма, описание)
    Колода -> Колода : перемешать()
    deactivate Колода

    Игра -> Кубики : создать()

    Игра -> Игрок : поставитьНаСтарт()
    note right: для каждого игрока:\nposition = 0, выдан стартовый капитал

    alt первый игрок определяется броском
        loop каждый игрок
            Игра -> Кубики : бросить()
            Игра <-- Кубики : сумма
        end
        note right: при равенстве — повторный бросок\nсреди претендентов
    else случайный выбор
        Игра -> Игра : выбратьПервогоИгрока()
    end

    Игра -> Игра : установитьТекущегоИгрока(индекс)
    note right: currentPlayerIndex = первый игрок;\nстатус = «идёт»
else игроков меньше 2
    Пользователь <-- Игра : ошибка: недостаточно игроков
end

Пользователь <-- Игра : игра начата, ход первого игрока
note right: дальше — UC2 «Сыграть ход»
deactivate Игра

@enduml
