@startuml
title Обязательный платёж и банкротство
hide footbox
skinparam noteBackgroundColor #FFF4B8

participant Program
participant Game
participant "debtor : Player" as Debtor
participant "creditor : Player" as Creditor
participant Board
participant "property : Property" as Property
participant "street : Street" as Street

[-> Game : ChargePayment(payer, receiver, amount)
activate Game
note over Game, Debtor
  Вызывается при оплате аренды, налога или штрафа по карточке.
  При аренде получатель — владелец клетки. При налоге или штрафе
  получатель отсутствует.
end note

Game -> Debtor : CanAfford(amount)
Debtor --> Game : bool

alt денег хватает сразу
    Game -> Debtor : Pay(amount)
    opt receiver != null
        Game -> Creditor : Receive(amount)
    end
else денег не хватает
    Game -> Game : HandleBankruptcy(payer, receiver, amount)
    activate Game
    Game -> Game : SellAllBuildings(debtor)
    activate Game
    Game -> Board : GetPropertiesOf(debtor)
    Board --> Game : properties
    loop по улицам должника
        Game -> Street : GetBuildingLevel()
        Street --> Game : level
        opt level > 0
            Game -> Debtor : Receive(level * street.HouseCost / 2)
            Game -> Street : ClearBuildings()
            note over Debtor, Street
              Каждая постройка продаётся за полцены.
              Отель считается за пять домов.
            end note
        end
    end
    deactivate Game

    Game -> Debtor : CanAfford(amount)
    Debtor --> Game : bool
    alt после продажи построек денег хватает
        Game -> Game : Log(message)
        Game -> Debtor : Pay(amount)
        opt creditor != null
            Game -> Creditor : Receive(amount)
        end
    else денег всё ещё не хватает
        Game -> Game : Log(message)
        alt creditor != null
            Game -> Creditor : Receive(debtor.Cash)
            Game -> Board : TransferProperties(debtor, creditor)
            activate Board
            Board -> Board : GetPropertiesOf(debtor)
            loop по всей собственности должника
                Board -> Property : SetOwner(creditor)
            end
            deactivate Board
        else creditor == null
            Game -> Board : ReleaseProperties(debtor)
            activate Board
            Board -> Board : GetPropertiesOf(debtor)
            loop по всей собственности должника
                opt клетка является улицей
                    Board -> Street : ClearBuildings()
                end
                Board -> Property : SetOwner(null)
            end
            deactivate Board
        end
        Game -> Debtor : DeclareBankrupt()
        note over Debtor
          Игрок помечается банкротом, его баланс
          обнуляется, признак заключения снимается.
        end note
        Game -> Game : CheckGameOver()
        activate Game
        Game -> Game : GetActivePlayers()
        opt активных игроков осталось не больше одного
            note over Game : Status = GameStatus.Finished.
        end
        Game --> Game : bool
        deactivate Game
    end
    deactivate Game
end
[<-- Game
deactivate Game

ref over Program, Game : Завершение Game.PlayTurn() — «Сыграть ход»
note over Program, Game
  После обработки клетки PlayTurn() вызывает CheckGameOver()
  и AdvanceToNextPlayer(). При статусе Finished очередь не меняется.
end note

opt Status == GameStatus.Finished
    Program -> Game : GetWinner()
    Game -> Game : GetActivePlayers()
    Game --> Program : первый активный Player или null
    note over Program : Программа выводит сообщение об окончании игры и имя победителя.
end

@enduml
