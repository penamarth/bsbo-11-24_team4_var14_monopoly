@startuml
title Сыграть ход
hide footbox
skinparam noteBackgroundColor #FFF4B8

actor "Игрок" as User
participant Program
participant ConsoleInput
participant Game
participant "player : Player" as Player
participant Dice
participant Board
participant "square : Square" as Square
participant Deck
participant Card
participant "destination : Square" as Destination

Program -> Game : GetCurrentPlayer()
Game --> Program : player
Program -> Program : Describe(game, player)
Program -> Board : GetSquare(player.Position)
Board --> Program : square
Program -> User : текущий игрок и меню
Program -> ConsoleInput : AskNumber(question)
ConsoleInput -> User : приглашение к вводу
User --> ConsoleInput : 1
ConsoleInput --> Program : choice
Program -> Game : PlayTurn()
activate Game
note over Game
  PlayTurn() сразу возвращает управление,
  если Status != GameStatus.InProgress.
end note
Game -> Game : GetCurrentPlayer()
Game -> Game : Log(message)

alt player.InJail
    Game -> Player : TryLeaveJail()
    Player --> Game : released
    note over Game, Player
      Увеличивается счётчик пропущенных ходов.
      На третьем пропуске снимается признак заключения.
      Бросок возможен со следующего хода этого игрока.
    end note
    Game -> Game : Log(message)
    Game -> Game : AdvanceToNextPlayer()
else игрок вне тюрьмы
    Game -> Dice : Roll()
    activate Dice
    note over Dice : Сохраняются два случайных значения от 1 до 6.
    Dice -> Dice : GetSum()
    Dice --> Game : sum
    deactivate Dice
    Game -> Game : Log(message)

    Game -> Player : Move(sum)
    note over Player
      Позиция обновляется по кругу из 40 клеток.
      При прохождении «Старта» игрок получает 200.
    end note
    Player --> Game : passedGo
    opt игрок прошёл «Старт»
        Game -> Game : Log(message)
    end

    Game -> Board : GetSquare(player.Position)
    Board --> Game : square
    Game -> Game : Log(message)
    Game -> Square : OnLand(player, game)
    activate Square
    note over Square : Поведение определяется типом клетки.

    alt Property без владельца
        Square -> Game : OfferPurchase(player, property)
        ref over Game, Square : Купить собственность / выставить на аукцион
    else Property другого игрока
        Square -> Square : CalculateRent(game)
        alt Street без построек
            Square -> Board : OwnsWholeGroup(Owner, ColorGroup)
            Board -> Board : GetStreetsInGroup(ColorGroup)
            Board --> Square : bool
            note over Board, Square : За всю цветовую группу базовая аренда удваивается.
        else Street с постройками
            note over Square : Аренда берётся из таблицы по числу домов или по отелю.
        else Railroad
            Square -> Board : CountRailroadsOf(Owner)
            Board --> Square : count
            note over Board, Square : Аренда — 25 за одну станцию и удваивается за каждую следующую.
        else Utility
            Square -> Board : CountUtilitiesOf(Owner)
            Board --> Square : count
            Square -> Dice : GetSum()
            Dice --> Square : sum
            note over Board, Square : Сумма кубиков умножается на 4 или 10 в зависимости от числа предприятий.
        end
        Square -> Game : Log(message)
        Square -> Game : ChargePayment(player, Owner, rent)
        ref over Game, Square : Обязательный платёж и банкротство
    else Tax
        Square -> Game : Log(message)
        Square -> Game : ChargePayment(player, null, Amount)
    else Chance или CommunityChest
        Square -> Deck : DrawCard()
        Deck --> Square : card
        Square -> Game : Log(message)
        Square -> Deck : ReturnToBottom(card)
        Square -> Card : ApplyEffect(player, game)
        activate Card
        alt EffectType.Fine
            Card -> Game : ChargePayment(player, null, Amount)
        else EffectType.Bonus
            Card -> Player : Receive(Amount)
        else EffectType.MoveTo
            Card -> Player : MoveTo(TargetPosition)
            Player --> Card : passedGo
            opt целевая позиция меньше исходной
                note over Player, Card : MoveTo() уже начислил 200 за прохождение «Старта».
                Card -> Game : Log(message)
            end
            Card -> Board : GetSquare(TargetPosition)
            Board --> Card : destination
            Card -> Game : Log(message)
            Card -> Destination : OnLand(player, game)
            note over Card, Destination
              В стандартных колодах целевая клетка —
              «Старт» или ул. Арбат. Она обрабатывается сразу.
            end note
        else EffectType.GoToJail
            Card -> Player : SendToJail()
        end
        deactivate Card
    else GoToJail
        Square -> Game : Log(message)
        Square -> Player : SendToJail()
        note over Player, Square
          Игрок перемещается на позицию 10 и считается заключённым.
          Счётчик пропущенных ходов обнуляется.
        end note
    else Своя Property, Go, Jail или FreeParking
        Square -> Game : Log(message)
    end
    Square --> Game
    deactivate Square

    Game -> Game : CheckGameOver()
    Game -> Game : GetActivePlayers()
    note over Game
      При числе активных игроков от 0 до 1
      Status становится GameStatus.Finished.
    end note
    Game -> Game : AdvanceToNextPlayer()
end
note over Game
  AdvanceToNextPlayer() при статусе InProgress
  выбирает следующего игрока по кругу, пропуская банкротов.
  При завершённой игре индекс не меняется.
end note
Game --> Program
deactivate Game

@enduml
