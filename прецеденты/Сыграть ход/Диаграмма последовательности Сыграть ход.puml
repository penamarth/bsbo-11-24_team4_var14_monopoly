@startuml

actor "Игрок" as Пользователь
participant "Игра" as Игра
participant "Кубики" as Кубики
participant "текущий\n: Игрок" as Текущий
participant "другой\n: Игрок" as Другой
participant "Доска" as Доска
participant "Клетка" as Клетка
participant "Аукцион" as Аукцион
participant "Колода" as Колода
participant "Карточка" as Карточка

Пользователь -> Игра : сыгратьХод()
note right: запускает обработку одного хода
activate Игра

Игра -> Кубики : бросить()
note right: генерирует значения двух кубиков
activate Кубики
Игра <-- Кубики : сумма
deactivate Кубики

Игра -> Текущий : переместить(сумма)
note right: меняет позицию игрока;\nпри прохождении «Старта» начисляет деньги
activate Текущий
deactivate Текущий

Игра -> Доска : получитьКлетку(позиция)
activate Доска
Игра <-- Доска : клетка
deactivate Доска

Игра -> Клетка : приПопадании(текущий, игра)
note right: клетка сама обрабатывает попадание\nв зависимости от своего типа
activate Клетка

alt Собственность, владелец пусто
    Клетка -> Игра : запроситьРешениеОПокупке(текущий, клетка)
    Клетка <-- Игра : решение
    alt игрок согласен и денег хватает
        Клетка -> Текущий : заплатить(цена)
        Клетка -> Клетка : установитьВладельца(текущий)
        note right: записывает игрока в поле владелец
    else игрок отказался
        Клетка -> Игра : начатьАукцион(клетка)
        activate Игра
        Игра -> Аукцион : создать(клетка, игроки)
        activate Аукцион
        Аукцион -> Аукцион : провестиТорги()
        alt есть победитель
            Аукцион -> Другой : заплатить(текущаяСтавка)
            note right: победителем может быть\nлюбой игрок, в т.ч. текущий
            Аукцион -> Клетка : установитьВладельца(победитель)
        else ставок не было
            note over Аукцион: владелец остаётся пустым
        end
        deactivate Аукцион
        deactivate Игра
    end

else Собственность, владелец — другой игрок
    Клетка -> Клетка : рассчитатьАренду()
    note right: Улица — по домам/отелю,\nЖД и Коммуналка — по своим формулам
    Клетка -> Текущий : хватаетДенег(аренда)
    alt денег хватает
        Клетка -> Текущий : заплатить(аренда)
        Клетка -> Другой : получить(аренда)
        note right: Другой — владелец клетки
    else денег не хватает
        Клетка -> Игра : обработатьБанкротство(текущий, владелец, аренда)
        note right: UC4
    end

else Налог
    Клетка -> Текущий : хватаетДенег(сумма)
    alt денег хватает
        Клетка -> Текущий : заплатить(сумма)
        note right: деньги выводятся из игры
    else денег не хватает
        Клетка -> Игра : обработатьБанкротство(текущий, нет, сумма)
        note right: UC4, кредитора нет
    end

else Шанс / Общая казна
    Клетка -> Колода : вытянутьКарту()
    activate Колода
    Клетка <-- Колода : карточка
    deactivate Колода
    Клетка -> Карточка : применитьЭффект(текущий, игра)
    activate Карточка
    Карточка -> Текущий : заплатить() / получить() / переместить() / отправитьВТюрьму()
    note right: штраф проверяется так же, как налог;\nпосле перемещения обрабатывается новая клетка
    deactivate Карточка

else «Отправляйся в тюрьму»
    Клетка -> Текущий : отправитьВТюрьму()
    note right: позиция = Тюрьма, вТюрьме = да

else своя клетка / Старт / Тюрьма / Бесплатная стоянка
    note over Клетка: эффекта нет
end

deactivate Клетка

Игра -> Игра : перейтиКСледующемуИгроку()
note right: следующий игрок, не являющийся банкротом
Пользователь <-- Игра : ход завершён
deactivate Игра

@enduml
