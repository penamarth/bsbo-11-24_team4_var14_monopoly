@startuml

entity "Игра" as Game
{
    индексТекущегоИгрока — номер игрока, который сейчас ходит
    статус — состояние партии (идёт / завершена)
}

entity "Игрок" as Player
{
    имя — имя участника, отображаемое в игре
    деньги — текущий баланс игрока
    позиция — номер клетки, на которой стоит фишка (0–39)
    вТюрьме — признак нахождения игрока в тюрьме
    банкрот — признак выбывания игрока из игры
}

entity "Доска" as Board
{
}

entity "Клетка" as Square
{
    название — наименование клетки на поле
    позиция — порядковый номер клетки на доске (0–39)
}

entity "Собственность" as Property
{
    цена — номинальная стоимость покупки
    <b>владелец</b> — игрок, которому принадлежит клетка (пусто — свободна)
}

entity "Улица" as Street
{
    цветоваяГруппа — цвет набора улиц (монополии)
    количествоДомов — число построенных домов (0–4)
    естьОтель — признак наличия отеля на улице
}

entity "ЖелезнаяДорога" as Railroad
{
}

entity "КоммунальноеПредприятие" as Utility
{
}

entity "Налог" as Tax
{
    сумма — фиксированная сумма налога к оплате
}

entity "Шанс" as Chance
{
}

entity "ОбщаяКазна" as CommunityChest
{
}

entity "Старт" as Go
{
}

entity "Тюрьма" as Jail
{
}

entity "БесплатнаяСтоянка" as FreeParking
{
}

entity "ОтправляйсяВТюрьму" as GoToJail
{
}

entity "Кубики" as Dice
{
    значение1 — результат броска первого кубика (1–6)
    значение2 — результат броска второго кубика (1–6)
}

entity "Колода" as Deck
{
    название — тип колоды (Шанс / Общая казна)
}

entity "Карточка" as Card
{
    типЭффекта — вид действия карточки (штраф, бонус, перемещение и т.п.)
    сумма — денежная величина эффекта, если есть
    описание — текст карточки, показываемый игроку
}

entity "Аукцион" as Auction
{
    текущаяСтавка — наибольшая ставка на данный момент
}

Game "1" -down- "2..6" Player : Включает
Game "1" -right- "1" Board : Разыгрывается на
Game "1" -right- "1" Dice : Использует
Game "1" -- "2" Deck : Использует
Game "1" -- "0..1" Auction : Инициирует

Board "1" -down- "40" Square : Состоит из {упорядочено}

Square <|-- Property
Square <|-- Tax
Square <|-- Chance
Square <|-- CommunityChest
Square <|-- Go
Square <|-- Jail
Square <|-- FreeParking
Square <|-- GoToJail

Property <|-- Street
Property <|-- Railroad
Property <|-- Utility

Deck "1" -down- "*" Card : Содержит

Player "1" -- "1" Square : Находится на
Property "0..*" --> "0..1" Player : Принадлежит >

Auction "0..1" -- "1" Property : Разыгрывает
Auction "1" -- "2..*" Player : Участвуют

@enduml